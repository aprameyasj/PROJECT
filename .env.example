# ---------------------------------------------------------------------------
# JARVIS configuration — copy to `.env` and edit.
# Every value is optional; sensible defaults are used when unset.
# ---------------------------------------------------------------------------

# --- LLM brain -------------------------------------------------------------
# With a key: real tool-calling model. Without one: the built-in offline intent
# engine still understands the whole MVP command set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_MODEL=gpt-4o-mini
# JARVIS_LLM_PROVIDER=auto        # auto | openai | offline
# JARVIS_LLM_TEMPERATURE=0.2
# JARVIS_MAX_STEPS=8              # tool calls allowed per utterance

# Any OpenAI-compatible endpoint works, e.g.:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_BASE_URL=http://localhost:11434/v1     (Ollama)
#   OPENAI_BASE_URL=http://localhost:1234/v1      (LM Studio)

# --- action backend --------------------------------------------------------
# auto    -> desktop when a GUI session exists, otherwise sandbox (simulated)
# desktop -> really move the mouse / launch apps
# sandbox -> simulate everything and record it (great for development)
JARVIS_BACKEND=auto
JARVIS_DRY_RUN=false

# --- safety ----------------------------------------------------------------
# normal -> Level 2 actions ask first, Level 3 is blocked
# strict -> ask for anything above Level 1
# yolo   -> never ask (not recommended)
JARVIS_SAFETY=normal
JARVIS_CONFIRM_SHELL=true
JARVIS_MAX_SHELL_SECONDS=60
JARVIS_CONFIRM_TTL=300

# --- identity --------------------------------------------------------------
JARVIS_NAME=JARVIS
JARVIS_USER_NAME=
JARVIS_WAKE_WORDS=jarvis, hey jarvis, hi jarvis

# --- storage ---------------------------------------------------------------
# JARVIS_HOME=./.jarvis           # database, screenshots, logs, downloads
# JARVIS_TIMEZONE=                # defaults to the system timezone

# --- voice -----------------------------------------------------------------
# JARVIS_STT=auto                 # auto | openai | faster_whisper | vosk | browser | off
# JARVIS_STT_MODEL=whisper-1
# JARVIS_TTS=auto                 # auto | openai | system | browser | off
# JARVIS_TTS_MODEL=gpt-4o-mini-tts
# JARVIS_TTS_VOICE=onyx           # alloy | echo | fable | onyx | nova | shimmer
# JARVIS_SPEAK=true
# JARVIS_LISTEN=false             # start the microphone loop with the API
# JARVIS_VOSK_MODEL=              # path to a downloaded Vosk model

# --- web tools -------------------------------------------------------------
# JARVIS_SEARCH_PROVIDER=duckduckgo     # duckduckgo | serper | brave
# SERPER_API_KEY=                       # google.serper.dev (best quality)
# BRAVE_SEARCH_API_KEY=
# JARVIS_SEARCH_RESULTS=5
# JARVIS_BROWSER_HEADLESS=true

# --- memory ----------------------------------------------------------------
# JARVIS_EMBEDDINGS=false         # vector memory (needs an API key)
# JARVIS_EMBEDDING_MODEL=text-embedding-3-small

# --- API server ------------------------------------------------------------
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000
# JARVIS_API_TOKEN=               # when set, every request needs X-Jarvis-Token
JARVIS_CORS_ORIGINS=*

# --- outbound communication (Level 2 — always asks before sending) ---------
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=587
# JARVIS_SMTP_USER=you@gmail.com
# JARVIS_SMTP_PASSWORD=           # use an app password
# JARVIS_MAIL_FROM=you@gmail.com
# JARVIS_WEBHOOK_URL=             # Slack / Discord / ntfy / IFTTT hook
